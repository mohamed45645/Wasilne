rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow read: if signedIn();
      allow update, delete: if signedIn() && request.auth.uid == userId;
      match /customers/{customerId} {
        allow read, create, update: if signedIn() && request.auth.uid == userId;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && ((request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 3000)
            || (request.resource.data.text is string
              && request.resource.data.text.size() == 0
              && request.resource.data.fileUrl is string
              && request.resource.data.filePath is string));
        allow update, delete: if false;
      }
    }
  }
}